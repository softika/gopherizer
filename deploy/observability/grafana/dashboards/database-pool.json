{
  "uid": "gopherizer-db-pool",
  "title": "Gopherizer / Database pool",
  "description": "Connection pool health. Saturation here is what pages someone: queries queue behind an exhausted pool long before the database itself looks unhealthy.",
  "tags": ["gopherizer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "In use",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(db_pool_connections{state=\"acquired\"})",
          "legendFormat": "acquired"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pool utilisation",
      "description": "Acquired connections as a share of the pool maximum. Sustained high utilisation is the warning that precedes queries queueing.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(db_pool_connections{state=\"acquired\"}) / clamp_min(sum(db_pool_connections_max), 1)",
          "legendFormat": "utilisation"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Acquire waits",
      "description": "Rate of acquisitions that found the pool empty and had to wait. Anything sustained above zero means the pool is too small for the load.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(db_pool_acquire_waits_total[$__rate_interval]))",
          "legendFormat": "waits"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Mean acquire duration",
      "description": "Average time an acquire took. This includes constructing a new connection, so it is not queueing time alone -- use the acquire waits panel for pool pressure.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 4, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(db_pool_acquire_duration_seconds_total[$__rate_interval])) / clamp_min(sum(rate(db_pool_acquires_total[$__rate_interval])), 1e-9)",
          "legendFormat": "mean acquire"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections by state",
      "description": "Acquired, idle and constructing against the configured maximum.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "fillOpacity": 20, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max" },
            "properties": [
              { "id": "custom.stacking", "value": { "mode": "none" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (state) (db_pool_connections)",
          "legendFormat": "{{state}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum(db_pool_connections_max)",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Acquisitions and waits",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(db_pool_acquires_total[$__rate_interval]))",
          "legendFormat": "acquires"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum(rate(db_pool_acquire_waits_total[$__rate_interval]))",
          "legendFormat": "waits"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "sum(rate(db_pool_acquire_cancels_total[$__rate_interval]))",
          "legendFormat": "cancels"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connections closed by reason",
      "description": "Churn. A high idle rate suggests the pool shrinks between bursts and pays to reconnect; a high lifetime rate suggests max lifetime is short for the traffic.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 20, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (reason) (rate(db_pool_connections_closed_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
